<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on Android 13+ to show pick-up / drop-off push alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Live bus location, shared only while a trip is running (TripLocationService) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Opening the bus location in a maps app (Android 11+ package visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".TransportApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TransportApp"
        tools:targetApi="31">

        <!-- Push alerts from the sendParentPush Cloud Function -->
        <service
            android:name=".TransportMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".TripLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="trip_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <activity
            android:name=".RouteReportActivity"
            android:exported="false" />
        <activity
            android:name=".StudentReportActivity"
            android:exported="false" />
        <activity
            android:name=".DriverReportActivity"
            android:exported="false" />
        <activity
            android:name=".Reports"
            android:exported="false" />
        <activity
            android:name=".DropOff"
            android:exported="false" />
        <activity
            android:name=".PickUp"
            android:exported="false" />
        <activity
            android:name=".DeleteStaff"
            android:exported="false" />
        <activity
            android:name=".DeleteRoute"
            android:exported="false" />
        <activity
            android:name=".DeleteVehicle"
            android:exported="false" />
        <activity
            android:name=".ModifyVehicle"
            android:exported="false" />
        <activity
            android:name=".AddVehicle"
            android:exported="false" />
        <activity
            android:name=".DeleteStudent"
            android:exported="false" />
        <activity
            android:name=".ModifyStudent"
            android:exported="false" />
        <activity
            android:name=".AddStudent"
            android:exported="false" />
        <activity
            android:name=".ModifyStaff"
            android:exported="false" />
        <activity
            android:name=".AddStaff"
            android:exported="false" />
        <activity
            android:name=".ModifyRoute"
            android:exported="false" />
        <activity
            android:name=".AddRoute"
            android:exported="false" />
        <activity
            android:name=".SignUp"
            android:exported="false" />
        <activity
            android:name=".Login"
            android:exported="false" /> <!-- ChatActivity, marked as non-exported for security -->
        <activity
            android:name=".ChatActivity"
            android:exported="false" /> <!-- ParentLanding Activity -->
        <activity
            android:name=".ParentLanding"
            android:exported="false" /> <!-- SchoolLanding Activity -->
        <activity
            android:name=".SchoolLanding"
            android:exported="false" /> <!-- Navigation Activity -->
        <activity
            android:name=".Navigation"
            android:exported="false" /> <!-- DriverLanding Activity -->
        <activity
            android:name=".DriverLanding"
            android:exported="false" /> <!-- MainActivity is exported since it's the entry point of the app -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>

                <!-- Main entry point to the app -->
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>