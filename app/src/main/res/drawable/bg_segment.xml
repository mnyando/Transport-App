<?xml version="1.0" encoding="utf-8"?>
<!-- One segment of a segmented control: indigo pill when checked, clear otherwise. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/theme_primary_container">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_checked="true" android:state_enabled="false">
                <shape>
                    <solid android:color="@color/text_hint" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:state_checked="true">
                <shape>
                    <solid android:color="@color/brand_primary" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
