<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar / status-bar strip. Horizontal so the strip behind the status bar lines up with the
     toolbar below it (SystemBars draws the same drawable there). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/brand_gradient_start"
        android:centerColor="@color/brand_gradient_mid"
        android:endColor="@color/brand_gradient_end"
        android:type="linear" />
</shape>
