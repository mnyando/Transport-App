<?xml version="1.0" encoding="utf-8"?>
<!-- Filled text field / dropdown: soft tinted fill at rest, indigo outline when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="2dp" android:color="@color/theme_primary" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_variant" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="1dp" android:color="@color/surface_variant" />
        </shape>
    </item>
</selector>
