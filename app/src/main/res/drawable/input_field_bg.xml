<?xml version="1.0" encoding="utf-8"?>
<!-- Filled field container. Put android:addStatesFromChildren="true" on the container so the
     indigo focus outline shows while its EditText is focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="2dp" android:color="@color/theme_primary" />
            <padding android:left="12dp" android:right="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_variant" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="1dp" android:color="@color/surface_variant" />
            <padding android:left="12dp" android:right="12dp" />
        </shape>
    </item>
</selector>
