<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <include
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout style="@style/Widget.Transport.CardHeader">

                    <ImageView
                        style="@style/Widget.Transport.IconBadge"
                        android:backgroundTint="@color/tile_cyan_container"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_driver"
                        app:tint="@color/tile_on_cyan" />

                    <TextView
                        style="@style/Widget.Transport.CardHeaderTitle"
                        android:text="@string/form_new_staff" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/form_details" />

                <EditText
                    android:id="@+id/driverNameInput"
                    style="@style/Widget.Transport.Field"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:autofillHints="name"
                    android:hint="@string/hint_staff_name"
                    android:inputType="textPersonName|textCapWords" />

                <EditText
                    android:id="@+id/driverPhoneInput"
                    style="@style/Widget.Transport.Field"
                    android:autofillHints="phone"
                    android:hint="@string/hint_phone_number"
                    android:inputType="phone" />

                <!-- Login email: links the driver's app account to this record (linkStaffAccount) -->
                <EditText
                    android:id="@+id/staffEmailInput"
                    style="@style/Widget.Transport.Field"
                    android:autofillHints="emailAddress"
                    android:hint="@string/staff_email_hint"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/licenseNumberInput"
                    style="@style/Widget.Transport.Field"
                    android:hint="@string/hint_license_number"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters" />

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:text="@string/form_assignment" />

                <Spinner
                    android:id="@+id/vehicleDropdown"
                    style="@style/Widget.Transport.Dropdown"
                    android:layout_marginTop="@dimen/spacing_s" />

                <Spinner
                    android:id="@+id/routeDropdown"
                    style="@style/Widget.Transport.Dropdown" />

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:text="@string/form_status" />

                <RadioGroup
                    android:id="@+id/statusRadioGroup"
                    style="@style/Widget.Transport.SegmentGroup">

                    <RadioButton
                        android:id="@+id/activeRadioButton"
                        style="@style/Widget.Transport.Segment"
                        android:checked="true"
                        android:text="@string/active" />

                    <RadioButton
                        android:id="@+id/notActiveRadioButton"
                        style="@style/Widget.Transport.Segment"
                        android:text="@string/not_active" />
                </RadioGroup>

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:text="@string/form_role" />

                <RadioGroup
                    android:id="@+id/roleRadioGroup"
                    style="@style/Widget.Transport.SegmentGroup">

                    <RadioButton
                        android:id="@+id/driverRadioButton"
                        style="@style/Widget.Transport.Segment"
                        android:checked="true"
                        android:text="@string/driver" />

                    <RadioButton
                        android:id="@+id/attendantRadioButton"
                        style="@style/Widget.Transport.Segment"
                        android:text="@string/attendant" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveDriverButton"
                    style="@style/Widget.Transport.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="@string/save_staff"
                    app:icon="@drawable/ic_check_24"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</LinearLayout>
