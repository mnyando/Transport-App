<?xml version="1.0" encoding="utf-8"?>
<!-- One child on the parent home. Sits inside the "Your children" card, so it is a tinted rounded
     panel rather than another outlined card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_row"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <!-- Name and grade -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/theme_primary_container"
            android:contentDescription="@null"
            android:padding="11dp"
            android:src="@drawable/ic_student"
            app:tint="@color/theme_on_primary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChildName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="John Doe" />

            <TextView
                android:id="@+id/tvGrade"
                style="@style/Widget.Transport.Pill"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/surface"
                android:text="@string/grade_3"
                android:textColor="@color/text_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:background="@drawable/bg_icon_rounded"
        android:backgroundTint="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_xs">

        <TextView
            android:id="@+id/tvRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_m"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:text="@string/route_a_westside"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_route"
            app:drawableTint="@color/tile_on_violet" />

        <TextView
            android:id="@+id/tvVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_m"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:text="@string/vehicle_bus_101"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_bus_24"
            app:drawableTint="@color/tile_on_amber" />

        <TextView
            android:id="@+id/tvDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_m"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_driver"
            app:drawableTint="@color/tile_on_cyan"
            tools:text="Driver: John Doe" />

        <TextView
            android:id="@+id/tvAttendant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_m"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/baseline_person_24"
            app:drawableTint="@color/text_accent"
            tools:text="Attendant: Jane Smith" />
    </LinearLayout>

    <!-- Pickup and drop-off times -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPickupTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_icon_rounded"
            android:backgroundTint="@color/status_success_container"
            android:drawablePadding="@dimen/spacing_s"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingHorizontal="@dimen/spacing_m"
            android:textColor="@color/status_on_success"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/clock_24"
            app:drawableTint="@color/status_on_success"
            tools:text="Pickup: 07:30 AM" />

        <TextView
            android:id="@+id/tvDropOffTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_icon_rounded"
            android:backgroundTint="@color/status_info_container"
            android:drawablePadding="@dimen/spacing_s"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingHorizontal="@dimen/spacing_m"
            android:textColor="@color/status_on_info"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/clock_24"
            app:drawableTint="@color/status_on_info"
            tools:text="Drop-off: 03:45 PM" />
    </LinearLayout>
</LinearLayout>
