<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <include
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Step 1: choose a route -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout style="@style/Widget.Transport.CardHeader">

                        <ImageView
                            style="@style/Widget.Transport.IconBadge"
                            android:backgroundTint="@color/tile_violet_container"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_route"
                            app:tint="@color/tile_on_violet" />

                        <TextView
                            style="@style/Widget.Transport.CardHeaderTitle"
                            android:text="@string/form_choose_route" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/routeRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:clipToPadding="false"
                        android:overScrollMode="always" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: edit -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout style="@style/Widget.Transport.CardHeader">

                        <ImageView
                            style="@style/Widget.Transport.IconBadge"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.CardHeaderTitle"
                            android:text="@string/form_details" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/routeNameInput"
                        style="@style/Widget.Transport.Field"
                        android:layout_marginTop="@dimen/spacing_l"
                        android:hint="@string/hint_route_id_name"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/totalDistanceInput"
                        style="@style/Widget.Transport.Field"
                        android:hint="@string/hint_total_distance_km"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/routeDescriptionInput"
                        style="@style/Widget.Transport.Field"
                        android:hint="@string/hint_route_description"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences" />

                    <Spinner
                        android:id="@+id/vehicleDropdown"
                        style="@style/Widget.Transport.Dropdown" />

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:text="@string/form_schedule" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/pickupTimeInput"
                            style="@style/Widget.Transport.Field"
                            android:layout_width="0dp"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:cursorVisible="false"
                            android:drawablePadding="@dimen/spacing_s"
                            android:focusable="false"
                            android:hint="@string/hint_pickup_time"
                            android:importantForAutofill="no"
                            android:inputType="none"
                            app:drawableStartCompat="@drawable/clock_24"
                            app:drawableTint="@color/text_hint" />

                        <EditText
                            android:id="@+id/dropOffTimeInput"
                            style="@style/Widget.Transport.Field"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:cursorVisible="false"
                            android:drawablePadding="@dimen/spacing_s"
                            android:focusable="false"
                            android:hint="@string/hint_drop_off_time"
                            android:importantForAutofill="no"
                            android:inputType="none"
                            app:drawableStartCompat="@drawable/clock_24"
                            app:drawableTint="@color/text_hint" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/updateRouteButton"
                        style="@style/Widget.Transport.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/update_route"
                        app:icon="@drawable/ic_check_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
