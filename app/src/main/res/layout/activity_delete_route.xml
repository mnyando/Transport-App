<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    android:padding="16dp">

    <!-- Navigation Bar -->
    <include
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- RecyclerView for route items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/routeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/white" />

    <!-- Beautified Modify Route Form Section inside CardView -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/white"
        android:padding="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Route ID/Name -->
            <EditText
                android:id="@+id/routeNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_route_id_name"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/edittext_background"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Total Distance -->
            <EditText
                android:id="@+id/totalDistanceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_total_distance"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/edittext_background"
                android:inputType="numberDecimal"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Route Description -->
            <EditText
                android:id="@+id/routeDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_route_description"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/edittext_background"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Vehicle Dropdown -->
            <Spinner
                android:id="@+id/vehicleDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/edittext_background" />

            <!-- Update Button -->
            <Button
                android:id="@+id/deleteRouteButton"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="@string/title_delete_route"
                android:layout_gravity="center"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/green"
                android:layout_marginTop="24dp"
                android:padding="16dp"
                android:drawablePadding="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
