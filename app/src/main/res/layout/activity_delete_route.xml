<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <include layout="@layout/delete_warning" />

            <!-- Step 1: choose a route -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout style="@style/Widget.Transport.CardHeader">

                        <ImageView
                            style="@style/Widget.Transport.IconBadge"
                            android:backgroundTint="@color/tile_violet_container"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_route"
                            app:tint="@color/tile_on_violet" />

                        <TextView
                            style="@style/Widget.Transport.CardHeaderTitle"
                            android:text="@string/form_choose_route" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/routeRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:clipToPadding="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: review and remove -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/form_details" />

                    <EditText
                        android:id="@+id/routeNameInput"
                        style="@style/Widget.Transport.Field"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:hint="@string/hint_route_id_name"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/totalDistanceInput"
                        style="@style/Widget.Transport.Field"
                        android:hint="@string/hint_total_distance"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/routeDescriptionInput"
                        style="@style/Widget.Transport.Field"
                        android:hint="@string/hint_route_description"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine" />

                    <Spinner
                        android:id="@+id/vehicleDropdown"
                        style="@style/Widget.Transport.Dropdown" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteRouteButton"
                        style="@style/Widget.Transport.Button.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/title_delete_route"
                        app:icon="@drawable/ic_delete_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
