<?xml version="1.0" encoding="utf-8"?>
<!-- Shared banner at the top of every "remove record" screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_icon_rounded"
    android:backgroundTint="@color/status_error_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_l">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_warning_24"
        app:tint="@color/status_on_error" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_weight="1"
        android:text="@string/form_delete_warning"
        android:textColor="@color/status_on_error"
        android:textSize="14sp" />
</LinearLayout>
