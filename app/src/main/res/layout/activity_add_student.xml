<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout style="@style/Widget.Transport.CardHeader">

                    <ImageView
                        style="@style/Widget.Transport.IconBadge"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_student" />

                    <TextView
                        style="@style/Widget.Transport.CardHeaderTitle"
                        android:text="@string/form_new_student" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/student" />

                <EditText
                    android:id="@+id/studentNameInput"
                    style="@style/Widget.Transport.Field"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:autofillHints="name"
                    android:hint="@string/hint_student_name"
                    android:inputType="textPersonName|textCapWords" />

                <Spinner
                    android:id="@+id/classDropdown"
                    style="@style/Widget.Transport.Dropdown" />

                <EditText
                    android:id="@+id/studentIdInput"
                    style="@style/Widget.Transport.Field"
                    android:hint="@string/hint_student_id_number"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <Spinner
                    android:id="@+id/routeDropdown"
                    style="@style/Widget.Transport.Dropdown" />

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:text="@string/parent_2" />

                <EditText
                    android:id="@+id/parentNameInput"
                    style="@style/Widget.Transport.Field"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:autofillHints="name"
                    android:hint="@string/hint_parent_name"
                    android:inputType="textPersonName|textCapWords" />

                <EditText
                    android:id="@+id/parentContactInput"
                    style="@style/Widget.Transport.Field"
                    android:autofillHints="phone"
                    android:hint="@string/hint_parent_contact"
                    android:inputType="phone" />

                <!-- Parent Email: links the parent's verified login to this student -->
                <EditText
                    android:id="@+id/parentEmailInput"
                    style="@style/Widget.Transport.Field"
                    android:autofillHints="emailAddress"
                    android:hint="@string/hint_parent_email_used_to_sign_in"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/homeLocationInput"
                    style="@style/Widget.Transport.Field"
                    android:autofillHints="postalAddress"
                    android:hint="@string/hint_home_location"
                    android:inputType="textPostalAddress" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveStudentButton"
                    style="@style/Widget.Transport.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="@string/title_add_student"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
