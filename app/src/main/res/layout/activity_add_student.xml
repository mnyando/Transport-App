<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    android:padding="16dp">

    <!-- Navigation Bar -->
    <include
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Add Student Form Section -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/surface"
        android:padding="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Student Name -->
            <EditText
                android:id="@+id/studentNameInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/hint_student_name"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"/>

            <!-- Class Dropdown -->
            <Spinner
                android:id="@+id/classDropdown"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:padding="12dp"/>

            <!-- Student ID Number -->
            <EditText
                android:id="@+id/studentIdInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/hint_student_id_number"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"/>

            <!-- Assigned Route Dropdown -->
            <Spinner
                android:id="@+id/routeDropdown"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:padding="12dp"/>

            <!-- Parent Name -->
            <EditText
                android:id="@+id/parentNameInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/hint_parent_name"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"/>

            <!-- Parent Contact -->
            <EditText
                android:id="@+id/parentContactInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/hint_parent_contact"
                android:inputType="phone"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"/>

            <!-- Parent Email: links the parent's verified login to this student -->
            <EditText
                android:id="@+id/parentEmailInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/hint_parent_email_used_to_sign_in"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"/>

            <!-- Home Location -->
            <EditText
                android:id="@+id/homeLocationInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/hint_home_location"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"/>

            <!-- Save Button -->
            <Button
                android:id="@+id/saveStudentButton"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/brand_primary"
                android:drawablePadding="8dp"
                android:padding="16dp"
                android:text="@string/title_add_student"
                android:textColor="@color/white"
                android:textSize="16sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
