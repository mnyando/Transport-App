<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <include
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <include layout="@layout/delete_warning" />

            <!-- Step 1: choose a staff member -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout style="@style/Widget.Transport.CardHeader">

                        <ImageView
                            style="@style/Widget.Transport.IconBadge"
                            android:backgroundTint="@color/tile_cyan_container"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_driver"
                            app:tint="@color/tile_on_cyan" />

                        <TextView
                            style="@style/Widget.Transport.CardHeaderTitle"
                            android:text="@string/form_choose_staff" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/driverRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: review (read-only) and remove -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/form_details" />

                    <EditText
                        android:id="@+id/driverNameInput"
                        style="@style/Widget.Transport.Field"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:enabled="false"
                        android:hint="@string/hint_staff_name"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/driverPhoneInput"
                        style="@style/Widget.Transport.Field"
                        android:enabled="false"
                        android:hint="@string/hint_phone_number"
                        android:importantForAutofill="no"
                        android:inputType="phone" />

                    <EditText
                        android:id="@+id/licenseNumberInput"
                        style="@style/Widget.Transport.Field"
                        android:enabled="false"
                        android:hint="@string/hint_license_number"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:text="@string/form_assignment" />

                    <Spinner
                        android:id="@+id/vehicleDropdown"
                        style="@style/Widget.Transport.Dropdown"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:enabled="false" />

                    <Spinner
                        android:id="@+id/routeDropdown"
                        style="@style/Widget.Transport.Dropdown"
                        android:enabled="false" />

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:text="@string/form_status" />

                    <RadioGroup
                        android:id="@+id/statusRadioGroup"
                        style="@style/Widget.Transport.SegmentGroup"
                        android:enabled="false">

                        <RadioButton
                            android:id="@+id/activeRadioButton"
                            style="@style/Widget.Transport.Segment"
                            android:checked="true"
                            android:text="@string/active" />

                        <RadioButton
                            android:id="@+id/notActiveRadioButton"
                            style="@style/Widget.Transport.Segment"
                            android:text="@string/not_active" />
                    </RadioGroup>

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:text="@string/form_role" />

                    <RadioGroup
                        android:id="@+id/roleRadioGroup"
                        style="@style/Widget.Transport.SegmentGroup"
                        android:enabled="false">

                        <RadioButton
                            android:id="@+id/driverRadioButton"
                            style="@style/Widget.Transport.Segment"
                            android:checked="true"
                            android:text="@string/driver" />

                        <RadioButton
                            android:id="@+id/attendantRadioButton"
                            style="@style/Widget.Transport.Segment"
                            android:text="@string/attendant" />
                    </RadioGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteStaffButton"
                        style="@style/Widget.Transport.Button.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/title_delete_staff"
                        app:icon="@drawable/ic_delete_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
