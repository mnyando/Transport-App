<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Gradient Background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/bg_gradient">

        <!-- Card for Login Form -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:padding="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            android:backgroundTint="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- App Logo -->
                <ImageView
                    android:contentDescription="@null"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/logo"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Login Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_to_your_account"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_accent"
                    android:gravity="center"
                    android:paddingBottom="16dp" />

                <!-- Email Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/input_field_bg"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:contentDescription="@null"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/baseline_email_24"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/gray" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_email"
                        android:textSize="16sp"
                        android:inputType="textEmailAddress"
                        android:textColorHint="@color/gray"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <!-- Password Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/input_field_bg"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:contentDescription="@null"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/baseline_lock_24"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/gray" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_password"
                        android:textSize="16sp"
                        android:inputType="textPassword"
                        android:textColorHint="@color/gray"
                        android:textColor="@color/text_primary"/>

                    <!-- Eye Icon for Password Visibility -->
                    <ImageView
                        android:contentDescription="@string/show_password"
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="11dp"
                        android:src="@drawable/baseline_remove_red_eye_24"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="@color/gray" />
                </LinearLayout>

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:textSize="14sp"
                    android:textColor="@color/text_accent"
                    android:layout_marginBottom="16dp"
                    android:gravity="end"
                    android:clickable="true" />

                <!-- Login Button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/login"
                    android:textSize="16sp"
                    android:backgroundTint="@color/brand_primary"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:padding="14dp" />

                <!-- Shown while signing in or reopening a saved session (review section 5) -->
                <ProgressBar
                    android:id="@+id/loginProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/signing_in"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

                <!-- No Account? Sign Up -->
                <TextView
                    android:id="@+id/tvSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_account_sign_up"
                    android:textSize="14sp"
                    android:textColor="@color/text_accent"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:clickable="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</RelativeLayout>
