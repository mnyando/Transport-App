<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="60dp" />

        <!-- General Information Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/general_info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="12dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/general_information"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_accent"
                    android:gravity="center"
                    android:paddingBottom="12dp"/>

                <!-- Image Section -->
                <ImageView
                    android:id="@+id/landing_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:paddingBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/landing_image" />

                <!-- Information Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:padding="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/surface">

                    <!-- Students Enrolled -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/students_enrolled_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="12dp"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:paddingTop="6dp"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/students_enrolled"
                                android:contentDescription="@null"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/students_enrolled"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:paddingTop="8dp"/>

                            <TextView
                                android:id="@+id/studentsEnrolledText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_2"
                                android:textSize="26sp"
                                android:textColor="@color/text_accent"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Routes Travelled -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/routes_travelled_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="12dp"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:paddingTop="6dp"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/routes_travelled"
                                android:contentDescription="@null"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/routes_travelled"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:paddingTop="8dp"/>

                            <TextView
                                android:id="@+id/routesTraveledText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_2"
                                android:textSize="26sp"
                                android:textColor="@color/text_accent"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Active Vehicles -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/active_vehicles_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="12dp"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/active_vehicles"
                                android:contentDescription="@null"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/active_vehicles"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:paddingTop="8dp"/>

                            <TextView
                                android:id="@+id/activeVehiclesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_2"
                                android:textSize="26sp"
                                android:textColor="@color/text_accent"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Inactive Vehicles -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/inactive_vehicles_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="12dp"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/inactive_vehicles"
                                android:contentDescription="@null"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/inactive_vehicles"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:paddingTop="8dp"/>

                            <TextView
                                android:id="@+id/inactiveVehiclesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_2"
                                android:textSize="26sp"
                                android:textColor="@color/text_error"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Active Drivers -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/active_drivers_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="12dp"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/active_driverr"
                                android:contentDescription="@null"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/active_drivers"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:paddingTop="8dp"/>

                            <TextView
                                android:id="@+id/activeDriversText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_2"
                                android:textSize="26sp"
                                android:textColor="@color/text_accent"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Inactive Drivers -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/inactive_drivers_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="12dp"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:paddingTop="6dp"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/inactive_driver"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/inactive_drivers"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:paddingTop="8dp"/>

                            <TextView
                                android:id="@+id/inactiveDriversText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_2"
                                android:textSize="26sp"
                                android:textColor="@color/text_error"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Title for Student Record Actions Section -->
        <TextView
            android:id="@+id/tvStudentRecordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_record_actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="1dp"
            android:layout_marginTop="24dp"
            android:gravity="center"/>

        <!-- Student Record Actions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:weightSum="3">

            <!-- Add Student Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/addStudent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/add_student"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_student_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Modify Student Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/modifyStudent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/modify_student"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modify_student_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Student Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deleteStudent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/delete_student"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_student_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Title for Vehicle Record Actions Section -->
        <TextView
            android:id="@+id/ManageVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_management"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="8dp"
            android:layout_marginTop="24dp"
            android:gravity="center"/>

        <!-- Vehicle Record Actions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:weightSum="3">

            <!-- Add Vehicle Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/AddVehicle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/add_vehicle"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_vehicle_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Modify Vehicle Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ModifyVehicle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/modify_vehicle"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modify_vehicle_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Vehicle Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/DeleteVehicle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/delete_vehicle"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_vehicle_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Title for Route Record Actions Section -->
        <TextView
            android:id="@+id/RouteRecordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_management"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="8dp"
            android:layout_marginTop="24dp"
            android:gravity="center"/>

        <!-- Route Record Actions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:weightSum="3">

            <!-- Add Route Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/AddRoute"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/add_route"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_route_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Modify Route Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ModifyRoute"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/modify_route"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modify_route_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Route Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/DeleteRoute"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/delete_routee"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_route_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Title for Staff Record Actions Section -->
        <TextView
            android:id="@+id/StaffRecordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/staff_management"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="8dp"
            android:layout_marginTop="24dp"
            android:gravity="center"/>

        <!-- Staff Record Actions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:weightSum="3">

            <!-- Add Staff Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/AddStaffRecord"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/add_staff"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_staff_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Modify Staff Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ModifyStaffRecord"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/modify_staff"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modify_staff_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Staff Record -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/DeleteStaffRecord"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:paddingTop="6dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/delete_staff"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_staff_record"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/dropOffButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/green"
                android:text="@string/drop_off"
                android:textColor="@android:color/white" />
        </LinearLayout>


        <Button
            android:id="@+id/reportsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edit_text_background"
            android:text="@string/reports"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Footer Section -->
        <include
            layout="@layout/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>