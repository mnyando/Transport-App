<?xml version="1.0" encoding="utf-8"?>
<!-- School admin hub: a gradient hero with the fleet numbers on glass tiles (tag="hero", see
     SystemBars), then one card per record type with Add / Edit / Remove tiles.
     Pull down to refresh the numbers. Tile ids are bound as CardView in SchoolLanding.java;
     MaterialCardView extends CardView. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/schoolRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:tag="hero">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Hero ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_s"
            android:paddingBottom="@dimen/spacing_xl"
            android:tag="hero_top">

            <!-- Top row: screen title + sign out (Session.setUpHomeToolbar shows the button) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_s"
                android:paddingEnd="0dp">

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_hero"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/signOutButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/glass_fill"
                    android:contentDescription="@string/sign_out"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/baseline_logout_24"
                    android:visibility="gone"
                    app:tint="@color/on_hero" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/school_hero_eyebrow"
                android:textAppearance="@style/TextAppearance.Transport.Eyebrow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_s"
                android:layout_marginTop="@dimen/spacing_xs"
                android:accessibilityHeading="true"
                android:text="@string/school_hero_headline"
                android:textAppearance="@style/TextAppearance.Transport.Display"
                android:textSize="26sp" />

            <!-- Stats row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Transport.GlassCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:id="@+id/studentsEnrolledText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/students_enrolled"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatLabel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Transport.GlassCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:id="@+id/routesTraveledText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/routes_travelled"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatLabel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Transport.GlassCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:id="@+id/activeVehiclesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_vehicles"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatLabel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Stats row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Transport.GlassCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:id="@+id/inactiveVehiclesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inactive_vehicles"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatLabel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Transport.GlassCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:id="@+id/activeDriversText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_drivers"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatLabel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Transport.GlassCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:id="@+id/inactiveDriversText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inactive_drivers"
                            android:textAppearance="@style/TextAppearance.Transport.HeroStatLabel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/school_overview_hint"
                android:textAppearance="@style/TextAppearance.Transport.HeroStatLabel" />
        </LinearLayout>

        <!-- ===== Record management ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginTop="@dimen/spacing_xl"
            android:accessibilityHeading="true"
            android:text="@string/school_manage"
            android:textAppearance="@style/TextAppearance.Transport.SectionLabel" />

        <!-- Students -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Transport.IconBadge"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_student" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/student_record_actions"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addStudent"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_student_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/modifyStudent"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_student_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/deleteStudent"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_student_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Staff -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Transport.IconBadge"
                        android:backgroundTint="@color/tile_cyan_container"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_driver"
                        app:tint="@color/tile_on_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/staff_management"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/AddStaffRecord"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_staff_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ModifyStaffRecord"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_staff_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/DeleteStaffRecord"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_staff_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Vehicles -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Transport.IconBadge"
                        android:backgroundTint="@color/tile_amber_container"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bus_24"
                        app:tint="@color/tile_on_amber" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/vehicle_management"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/AddVehicle"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_vehicle_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ModifyVehicle"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_vehicle_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/DeleteVehicle"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_vehicle_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Routes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Transport.IconBadge"
                        android:backgroundTint="@color/tile_violet_container"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_route"
                        app:tint="@color/tile_on_violet" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/route_management"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/AddRoute"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_route_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ModifyRoute"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_route_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/DeleteRoute"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_route_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="92dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- More: reports and the parent sign-up code -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginTop="@dimen/spacing_xl"
            android:accessibilityHeading="true"
            android:text="@string/school_more"
            android:textAppearance="@style/TextAppearance.Transport.SectionLabel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportsButton"
            style="@style/Widget.Transport.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/reports"
            app:icon="@drawable/ic_assessment_24"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inviteCodeButton"
            style="@style/Widget.Transport.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/invite_code_button"
            app:icon="@drawable/ic_person_add_24"
            app:iconGravity="textStart" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            layout="@layout/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
