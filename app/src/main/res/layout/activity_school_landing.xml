<?xml version="1.0" encoding="utf-8"?>
<!-- School admin hub (DESIGN_SYSTEM_AND_PLAN.md, screen 3): a fleet overview card, then one card per
     record type with Add / Edit / Remove tiles. Pull down to refresh the numbers (review #20).
     Tile ids are bound as CardView in SchoolLanding.java; MaterialCardView extends CardView. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/schoolRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_l">

        <!-- Fleet overview -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/general_information"
                        android:textAppearance="@style/TextAppearance.Transport.Header" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/school_overview_hint"
                        android:textAppearance="@style/TextAppearance.Transport.StatLabel" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_s">

                        <TextView
                            android:id="@+id/studentsEnrolledText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.StatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/students_enrolled"
                            android:textAppearance="@style/TextAppearance.Transport.StatLabel" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_s">

                        <TextView
                            android:id="@+id/routesTraveledText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.StatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/routes_travelled"
                            android:textAppearance="@style/TextAppearance.Transport.StatLabel" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_s">

                        <TextView
                            android:id="@+id/activeVehiclesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.StatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/active_vehicles"
                            android:textAppearance="@style/TextAppearance.Transport.StatLabel" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/spacing_s"
                    android:background="@color/outline_card" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_s">

                        <TextView
                            android:id="@+id/inactiveVehiclesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.StatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/inactive_vehicles"
                            android:textAppearance="@style/TextAppearance.Transport.StatLabel" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_s">

                        <TextView
                            android:id="@+id/activeDriversText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.StatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/active_drivers"
                            android:textAppearance="@style/TextAppearance.Transport.StatLabel" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_s">

                        <TextView
                            android:id="@+id/inactiveDriversText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_2"
                            android:textAppearance="@style/TextAppearance.Transport.StatValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/inactive_drivers"
                            android:textAppearance="@style/TextAppearance.Transport.StatLabel" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Students -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/theme_primary_container"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_student"
                        app:tint="@color/theme_on_primary_container" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/student_record_actions"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addStudent"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_student_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/modifyStudent"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_student_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/deleteStudent"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_student_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Staff -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/theme_primary_container"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_driver"
                        app:tint="@color/theme_on_primary_container" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/staff_management"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/AddStaffRecord"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_staff_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ModifyStaffRecord"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_staff_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/DeleteStaffRecord"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_staff_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Vehicles -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/theme_primary_container"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_bus_24"
                        app:tint="@color/theme_on_primary_container" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/vehicle_management"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/AddVehicle"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_vehicle_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ModifyVehicle"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_vehicle_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/DeleteVehicle"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_vehicle_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Routes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/theme_primary_container"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_route"
                        app:tint="@color/theme_on_primary_container" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/route_management"
                        android:textAppearance="@style/TextAppearance.Transport.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/AddRoute"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/add_route_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ModifyRoute"
                    style="@style/Widget.Transport.Tile"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/modify_route_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_edit" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/DeleteRoute"
                    style="@style/Widget.Transport.Tile"
                    android:contentDescription="@string/delete_route_record">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            style="@style/Widget.Transport.TileIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete_24"
                            app:tint="@color/status_on_error" />

                        <TextView
                            style="@style/Widget.Transport.TileLabel"
                            android:text="@string/tile_remove" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- More: reports and the parent sign-up code (review #2) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:accessibilityHeading="true"
            android:text="@string/school_more"
            android:textAppearance="@style/TextAppearance.Transport.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportsButton"
            style="@style/Widget.Transport.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/reports"
            app:icon="@drawable/ic_assessment_24"
            app:iconGravity="textStart"
            app:iconTint="@color/brand_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inviteCodeButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:minHeight="@dimen/touch_target_driver"
            android:text="@string/invite_code_button"
            android:textSize="16sp"
            app:cornerRadius="@dimen/radius_pill"
            app:icon="@drawable/ic_person_add_24"
            app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Footer Section -->
        <include
            layout="@layout/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
