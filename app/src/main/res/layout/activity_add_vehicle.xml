<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <LinearLayout style="@style/Widget.Transport.CardHeader">

                    <ImageView
                        style="@style/Widget.Transport.IconBadge"
                        android:backgroundTint="@color/tile_amber_container"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bus_24"
                        app:tint="@color/tile_on_amber" />

                    <TextView
                        style="@style/Widget.Transport.CardHeaderTitle"
                        android:text="@string/form_new_vehicle" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/form_details" />

                <EditText
                    android:id="@+id/vehicleNameInput"
                    style="@style/Widget.Transport.Field"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:hint="@string/hint_vehicle_name"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />

                <EditText
                    android:id="@+id/vehicleNumberInput"
                    style="@style/Widget.Transport.Field"
                    android:hint="@string/hint_vehicle_number"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters" />

                <EditText
                    android:id="@+id/capacityInput"
                    style="@style/Widget.Transport.Field"
                    android:hint="@string/hint_capacity"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    style="@style/Widget.Transport.FieldLabel"
                    android:text="@string/form_status" />

                <RadioGroup
                    android:id="@+id/statusRadioGroup"
                    style="@style/Widget.Transport.SegmentGroup">

                    <RadioButton
                        android:id="@+id/activeRadioButton"
                        style="@style/Widget.Transport.Segment"
                        android:checked="true"
                        android:text="@string/active" />

                    <RadioButton
                        android:id="@+id/notActiveRadioButton"
                        style="@style/Widget.Transport.Segment"
                        android:text="@string/not_active" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveVehicleButton"
                    style="@style/Widget.Transport.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="@string/title_add_vehicle"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
