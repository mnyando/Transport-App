<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Gradient Background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/bg_gradient">

        <!-- Card for Sign-Up Form -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:padding="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- App Logo -->
                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/logo"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Sign-Up Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_an_account"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/green"
                    android:gravity="center"
                    android:paddingBottom="16dp" />

                <!-- Full Name Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/input_field_bg"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/baseline_person_24"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/gray" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_full_name"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:textColorHint="@color/gray"
                        android:textColor="@color/black"/>
                </LinearLayout>

                <!-- Email Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/input_field_bg"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/baseline_email_24"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/gray" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_email"
                        android:textSize="16sp"
                        android:inputType="textEmailAddress"
                        android:textColorHint="@color/gray"
                        android:textColor="@color/black"/>
                </LinearLayout>

                <!-- Password Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/input_field_bg"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/baseline_lock_24"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/gray" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_password"
                        android:textSize="16sp"
                        android:inputType="textPassword"
                        android:textColorHint="@color/gray"
                        android:textColor="@color/black"/>

                    <!-- Eye Icon for Password Visibility -->
                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/baseline_remove_red_eye_24"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="@color/gray" />
                </LinearLayout>

                <!-- Consent (review section 3): required before an account is created -->
                <CheckBox
                    android:id="@+id/cbConsent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/consent_checkbox"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPrivacyNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="0dp"
                    android:text="@string/privacy_notice_link"
                    android:textColor="@color/green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Sign-Up Button -->
                <Button
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/sign_up"
                    android:textSize="16sp"
                    android:backgroundTint="@color/green"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:padding="14dp" />

                <!-- Already Have an Account? Sign In -->
                <TextView
                    android:id="@+id/tvSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/already_have_an_account_sign_in"
                    android:textSize="14sp"
                    android:textColor="@color/green"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:clickable="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</RelativeLayout>
