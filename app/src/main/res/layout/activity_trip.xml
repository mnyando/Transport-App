<?xml version="1.0" encoding="utf-8"?>
<!-- Pick-up / drop-off run (TripActivity). Driver road screen (DESIGN_SYSTEM_AND_PLAN.md, screen 1):
     a status card at the top, one card per child, and a large sticky action button at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <include
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <!-- Trip status: not started / started at ... / how many children are marked -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_l"
        android:layout_marginBottom="@dimen/spacing_s">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_l">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/status_info_container"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_bus_24"
                app:tint="@color/status_on_info" />

            <TextView
                android:id="@+id/tripStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Transport.Title" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/studentListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_l" />

        <ProgressBar
            android:id="@+id/tripProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/loading"
            android:indeterminateTint="@color/brand_primary" />

        <!-- No children / could not load, with a retry -->
        <LinearLayout
            android:id="@+id/tripEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xxl"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/surface_variant"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_student"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tripEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Transport.Body"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tripRetryButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- Sticky primary action: Start trip / Complete trip. 64dp tall for use on the road. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/tripActionButton"
        style="@style/Widget.Transport.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginBottom="@dimen/spacing_l"
        android:elevation="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="64dp"
        android:stateListAnimator="@null" />
</LinearLayout>
