<?xml version="1.0" encoding="utf-8"?>
<!-- Edit a student: pick one from the filtered list, then edit the details below. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Navigation Bar -->
        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Step 1: choose a student -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.Transport.IconBadge"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_student" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_m"
                            android:layout_weight="1"
                            android:text="@string/select_student"
                            android:textAppearance="@style/TextAppearance.Transport.Title" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/filterDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_l"
                        style="@style/Widget.Transport.Dropdown" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/studentRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: edit details -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.Transport.IconBadge"
                            android:backgroundTint="@color/tile_violet_container"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_24"
                            app:tint="@color/tile_on_violet" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_m"
                            android:layout_weight="1"
                            android:text="@string/title_modify_student"
                            android:textAppearance="@style/TextAppearance.Transport.Title" />
                    </LinearLayout>

                    <!-- Student -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_l"
                        android:text="@string/student"
                        android:textAppearance="@style/TextAppearance.Transport.SectionLabel" />

                    <EditText
                        android:id="@+id/studentNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:autofillHints="name"
                        android:background="@drawable/edittext_background"
                        android:hint="@string/hint_student_name"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/classDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        style="@style/Widget.Transport.Dropdown" />

                    <EditText
                        android:id="@+id/studentIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:background="@drawable/edittext_background"
                        android:hint="@string/hint_student_id_number"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/routeDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        style="@style/Widget.Transport.Dropdown" />

                    <!-- Parent -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/parent_2"
                        android:textAppearance="@style/TextAppearance.Transport.SectionLabel" />

                    <EditText
                        android:id="@+id/parentNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:autofillHints="name"
                        android:background="@drawable/edittext_background"
                        android:hint="@string/hint_parent_name"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/parentContactInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:autofillHints="phone"
                        android:background="@drawable/edittext_background"
                        android:hint="@string/hint_parent_contact"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <!-- Parent Email: links the parent's verified login to this student -->
                    <EditText
                        android:id="@+id/parentEmailInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:autofillHints="emailAddress"
                        android:background="@drawable/edittext_background"
                        android:hint="@string/hint_parent_email_used_to_sign_in"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/homeLocationInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:autofillHints="postalAddress"
                        android:background="@drawable/edittext_background"
                        android:hint="@string/hint_home_location"
                        android:inputType="textPostalAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveStudentButton"
                        style="@style/Widget.Transport.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/title_modify_student"
                        app:icon="@drawable/ic_check_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
