<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <include layout="@layout/delete_warning" />

            <!-- Step 1: choose a student -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout style="@style/Widget.Transport.CardHeader">

                        <ImageView
                            style="@style/Widget.Transport.IconBadge"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_student" />

                        <TextView
                            style="@style/Widget.Transport.CardHeaderTitle"
                            android:text="@string/select_student" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/filterDropdown"
                        style="@style/Widget.Transport.Dropdown"
                        android:layout_marginTop="@dimen/spacing_l" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/studentRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: review and remove -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/student" />

                    <EditText
                        android:id="@+id/studentNameInput"
                        style="@style/Widget.Transport.Field"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:hint="@string/hint_student_name"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName" />

                    <Spinner
                        android:id="@+id/classDropdown"
                        style="@style/Widget.Transport.Dropdown" />

                    <EditText
                        android:id="@+id/studentIdInput"
                        style="@style/Widget.Transport.Field"
                        android:hint="@string/hint_student_id_number"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <Spinner
                        android:id="@+id/routeDropdown"
                        style="@style/Widget.Transport.Dropdown" />

                    <TextView
                        style="@style/Widget.Transport.FieldLabel"
                        android:text="@string/parent_2" />

                    <EditText
                        android:id="@+id/parentNameInput"
                        style="@style/Widget.Transport.Field"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:hint="@string/hint_parent_name"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName" />

                    <EditText
                        android:id="@+id/parentContactInput"
                        style="@style/Widget.Transport.Field"
                        android:hint="@string/hint_parent_contact"
                        android:importantForAutofill="no"
                        android:inputType="phone" />

                    <EditText
                        android:id="@+id/homeLocationInput"
                        style="@style/Widget.Transport.Field"
                        android:hint="@string/hint_home_location"
                        android:importantForAutofill="no"
                        android:inputType="textPostalAddress" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteStudentButton"
                        style="@style/Widget.Transport.Button.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:text="@string/title_delete_student"
                        app:icon="@drawable/ic_delete_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
