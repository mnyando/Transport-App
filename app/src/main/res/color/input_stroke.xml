<?xml version="1.0" encoding="utf-8"?>
<!-- Text field outline: invisible at rest (filled box), indigo when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/theme_primary" android:state_focused="true" />
    <item android:color="@color/text_hint" android:state_hovered="true" />
    <item android:color="@color/border_light" />
</selector>
