<?xml version="1.0" encoding="utf-8"?>
<!-- Design-system text and component styles (DESIGN_SYSTEM_AND_PLAN.md, step 1).
     Colours come from tokens with day/night values, so every style works in both themes. -->
<resources>
    <!-- Screen header -->
    <style name="TextAppearance.Transport.Header" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Card title -->
    <style name="TextAppearance.Transport.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Body text -->
    <style name="TextAppearance.Transport.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Subtitle / meta -->
    <style name="TextAppearance.Transport.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Badge / status pill text (set textColor to the matching status_on_* token) -->
    <style name="TextAppearance.Transport.Badge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card: 16dp radius, low elevation, 1dp subtle outline -->
    <style name="Widget.Transport.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardElevation">@dimen/card_elevation_default</item>
        <item name="strokeColor">@color/outline_card</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Admin action tile: flat, tinted, one of three equal tiles in a row -->
    <style name="Widget.Transport.Tile" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Icon inside an admin tile -->
    <style name="Widget.Transport.TileIcon" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/text_accent</item>
    </style>

    <!-- Label inside an admin tile (the tile's contentDescription carries the full action) -->
    <style name="Widget.Transport.TileLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_s</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Fleet overview number and label -->
    <style name="TextAppearance.Transport.StatValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_accent</item>
    </style>

    <style name="TextAppearance.Transport.StatLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Primary action button: brand blue, pill shape, large driver-friendly target -->
    <style name="Widget.Transport.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="android:minHeight">@dimen/touch_target_action</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>
</resources>
