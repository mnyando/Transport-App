<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Colour roles point at theme_* tokens, which have
         light values in values/colors.xml and dark values in values-night/colors.xml. -->
    <style name="Base.Theme.TransportApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_on_primary_container</item>
        <item name="colorSecondary">@color/brand_gradient_end</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_light</item>
        <item name="colorOutlineVariant">@color/outline_card</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="android:windowBackground">@color/screen_background</item>

        <!-- Component defaults so every screen picks up the design system -->
        <item name="materialCardViewStyle">@style/Widget.Transport.Card</item>
        <item name="materialButtonStyle">@style/Widget.Transport.Button</item>
        <item name="textInputStyle">@style/Widget.Transport.TextInput</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Transport.ExtraLarge</item>
    </style>

    <!-- Dialogs and bottom sheets get softer, larger corners -->
    <style name="ShapeAppearance.Transport.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="Theme.TransportApp" parent="Base.Theme.TransportApp" />
</resources>
