<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TransportApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colours (review section 4: colours live in colors.xml and the theme) -->
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Cards keep the raised look of the old androidx CardView -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
    </style>

    <style name="Theme.TransportApp" parent="Base.Theme.TransportApp" />
</resources>