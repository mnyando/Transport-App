<?xml version="1.0" encoding="utf-8"?>
<!-- Design-system sizes. Spacing follows a 4/8dp grid. -->
<resources>
    <!-- Spacing scale -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>
    <dimen name="spacing_m">12dp</dimen>
    <dimen name="spacing_l">16dp</dimen>
    <dimen name="spacing_xl">24dp</dimen>
    <dimen name="spacing_xxl">32dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_m">16dp</dimen>
    <dimen name="radius_l">24dp</dimen>
    <dimen name="radius_xl">32dp</dimen>
    <dimen name="radius_pill">100dp</dimen>

    <!-- Touch targets: 48dp minimum everywhere, larger for in-vehicle driver controls -->
    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="touch_target_driver">56dp</dimen>
    <dimen name="touch_target_action">60dp</dimen>

    <!-- Card elevation: flat cards with a hairline outline; raised only for floating panels -->
    <dimen name="card_elevation_default">0dp</dimen>
    <dimen name="card_elevation_raised">8dp</dimen>
</resources>
